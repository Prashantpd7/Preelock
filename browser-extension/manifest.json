{
  "manifest_version": 3,
  "name": "VYSTRIQ Focus Bridge",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "description": "Voluntary, session-scoped browser filtering paired with VYSTRIQ Desktop.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": ["http://127.0.0.1:47832/*"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "VYSTRIQ focus status and recovery"
  }
}
