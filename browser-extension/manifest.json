{
  "manifest_version": 3,
  "name": "Preelock",
  "version": "0.5.2",
  "minimum_chrome_version": "120",
  "description": "Voluntary, session-scoped browser filtering paired with Preelock Desktop.",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": ["http://127.0.0.1:47832/*"],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Preelock",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "incognito": "spanning"
}
