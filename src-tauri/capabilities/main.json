{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the local main and blocked-app windows can access the focus application commands.",
  "windows": ["main", "blocked-app"],
  "permissions": [
    "read-state",
    "settings-tools",
    "change-state",
    "read-capabilities",
    "focus-setup",
    "camera-consent",
    "browser-pairing-reset",
    "open-setup",
    "read-app-icons",
    "dismiss-blocked-app"
  ]
}
