{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VYSTRIQ",
  "version": "0.4.0",
  "identifier": "com.vystriq.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "VYSTRIQ",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Make room for deep work.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "../browser-extension/manifest.json": "browser-extension/manifest.json",
      "../browser-extension/worker.js": "browser-extension/worker.js",
      "../browser-extension/rules.js": "browser-extension/rules.js",
      "../browser-extension/self-test.js": "browser-extension/self-test.js",
      "../browser-extension/popup.html": "browser-extension/popup.html",
      "../browser-extension/popup.css": "browser-extension/popup.css",
      "../browser-extension/popup.js": "browser-extension/popup.js"
    }
  }
}
